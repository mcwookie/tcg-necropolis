# Copy to .env next to compose.yaml and adjust. Every setting is optional
# unless noted.

# Where card images, decks and profiles live on this machine.
TCGNECRO_DATA_DIR=./data
# Owner of that folder (`id -u` / `id -g`), so the container can write to it.
TCGNECRO_UID=1000
TCGNECRO_GID=1000

# Port on this machine. 127.0.0.1 = this machine only (behind Caddy or a
# tunnel); 0.0.0.0 = reachable from your network.
TCGNECRO_BIND=127.0.0.1
TCGNECRO_PORT=8000

# https profile only: your domain (required for it), and secure cookies on.
#TCGNECRO_DOMAIN=necro.example.com
#TCGNECRO_SECURE_COOKIES=1

# Minutes between automatic deck syncs with ArkhamDB (0 = off).
#TCGNECRO_SYNC_MINUTES=60

# Pin a specific build instead of following main, e.g. :sha-1a2b3c4
#TCGNECRO_IMAGE=ghcr.io/mcwookie/tcg-necropolis:latest
